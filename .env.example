APP_NAME=DataPilot AI
APP_ENV=development          # set to "production" to enforce a real SECRET_KEY
DEBUG=false

# REQUIRED in production: long random string (e.g. `openssl rand -hex 32`)
SECRET_KEY=change-me
ACCESS_TOKEN_MINUTES=720
ALLOW_REGISTRATION=true
# Comma-separated emails of EXISTING accounts to promote to super_admin at startup (grants /admin panel access).
# Or run: uv run python -m scripts.make_super_admin you@example.com
SUPER_ADMIN_EMAILS=
USAGE_LOG_RETENTION_DAYS=60

# Secrets used by the admin-configured features. Never stored in the DB or shown in the UI.
SMTP_PASSWORD=
PAYMENT_GATEWAY_SECRET=

# Application database. PostgreSQL (recommended) or SQLite for quick local dev:
#   DATABASE_URL=postgresql+psycopg://datapilot:datapilot@localhost:5432/datapilot
DATABASE_URL=sqlite:///./data/app.db

# Comma-separated list (or JSON array) of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Storage
UPLOAD_DIRECTORY=./data/uploads
PROCESSED_DIRECTORY=./data/processed
REPORT_DIRECTORY=./storage/reports

# Limits
MAX_UPLOAD_MB=100
MAX_QUERY_ROWS=10000
QUERY_TIMEOUT_SECONDS=30

# Optional LLM (routing, NL->SQL, answer wording). Leave as "none" to run fully deterministic.
# Every LLM-produced SQL statement is validated read-only and every numeric claim is re-verified.
LLM_PROVIDER=none            # none | anthropic | google
LLM_MODEL=                   # blank = provider default
LLM_TEMPERATURE=0.1
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=


# LLM_PROVIDER=google
# LLM_MODEL=gemini-2.5-flash
# GOOGLE_API_KEY=your_google_gemini_api_key